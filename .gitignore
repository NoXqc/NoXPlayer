app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Distributed via GitHub Releases, not tracked in source control
*.apk

# Ad-hoc debug screenshots pulled from devices during development
/nox_*.png

# Release signing secrets — never committed. Losing this keystore means
# every existing install can never seamlessly update again (a new key
# forces the same one-time uninstall/reinstall this file exists to avoid
# repeating). Back it up somewhere outside this repo.
/android/key.properties
*.jks
*.keystore
